# ─────────────────────────────────────────────────────────────────────────────
# .env.example — committed to git as documentation of all required variables.
#
# Copy to .env.local for local development (dev Firebase project).
# Copy to .env.production.local for local production builds.
# In CI/CD (Vercel / GitHub Actions) set these in the platform's secret store.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Client SDK (NEXT_PUBLIC_ = bundled into client JavaScript) ───────
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# ── Firebase Admin SDK (server-only, used in API routes & instrumentation) ────
# Obtain from Firebase Console → Project Settings → Service accounts.
# Never prefix these with NEXT_PUBLIC_ — they must not reach the browser.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
