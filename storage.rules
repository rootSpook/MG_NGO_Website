// ─────────────────────────────────────────────────────────────────────────────
// Firebase Storage Security Rules
// Project: ngo-mg-website-47a1a
//
// Path structure
// ──────────────
// public/   – Publicly readable assets (images, PDFs shown on the website).
//             Only authenticated staff may upload or overwrite.
// private/  – Staff-only assets (internal documents, reports).
//             Only authenticated staff may read or write.
//
// Delete is restricted to authenticated users across all paths.
//
// Why no firestore.get() here:
//   Cross-service calls from Storage Rules to Firestore are unreliable —
//   they can silently time out, causing uploadBytes() to hang indefinitely
//   (the "infinite spinner" bug). Role enforcement is handled at the
//   application layer (admin route middleware + AuthContext role check).
//
// Upload constraints (both paths):
//   • Max file size : 10 MB
//   • Allowed types : image/jpeg, image/png, image/gif, image/webp,
//                     image/svg+xml, application/pdf
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidUpload() {
      return request.resource.size <= 10 * 1024 * 1024 &&
             request.resource.contentType in [
               "image/jpeg",
               "image/png",
               "image/gif",
               "image/webp",
               "image/svg+xml",
               "application/pdf"
             ];
    }

    // ── public/ ───────────────────────────────────────────────────────────────
    match /public/{allPaths=**} {
      allow read:   if true;
      allow write:  if isAuthenticated() && isValidUpload();
      allow delete: if isAuthenticated();
    }

    // ── private/ ──────────────────────────────────────────────────────────────
    match /private/{allPaths=**} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && isValidUpload();
      allow delete: if isAuthenticated();
    }

    // ── Default: deny everything else ────────────────────────────────────────
    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
