# ─────────────────────────────────────────────────────────────────────────────
# .env.production — TEMPLATE ONLY
#
# DO NOT commit real values. Copy this file to .env.production.local for local
# production builds, or populate these in your Vercel project's "Production"
# environment variable scope.
#
# NEXT_PUBLIC_* vars are baked into the client bundle at build time.
# All other vars are server-only (API routes / instrumentation).
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Client SDK (public — safe to expose in browser bundle) ───────────
# These must point to the PRODUCTION Firebase project, not the dev project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server-only — NEVER prefix with NEXT_PUBLIC_) ─────────
# Generate a service account key in Firebase Console → Project Settings →
# Service accounts → Generate new private key. Store the values here as
# individual fields rather than the raw JSON file.
#
# IMPORTANT: The private key contains literal \n characters. In Vercel's
# dashboard these are preserved automatically. In a local .env file, wrap
# the entire value in double quotes so newlines are not stripped.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.your-ngo-domain.org
NODE_ENV=production
