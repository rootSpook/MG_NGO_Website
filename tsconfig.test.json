{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "esnext",
    "types": ["node"],
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.config.ts",
    "lib/**/*.ts",
    "components/**/*.tsx",
    "types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
